CREATE INDEX idx_products_product
                ON products(product);
CREATE INDEX idx_products_product_version
                ON products(product, version);
CREATE INDEX idx_referenced_exploit_cve
                ON referenced_exploit(cve_id);
CREATE INDEX idx_referenced_metasploit_cve
                ON referenced_metasploit(cve_id);
CREATE INDEX idx_affected_product
                ON affected(product_id);
CREATE INDEX idx_multiaffected_product
                ON multiaffected(product_id);
CREATE INDEX idx_skipped_affected_product
                ON skipped_affected(product);
CREATE INDEX idx_backports_cve
                ON backports(cve_id);
CREATE INDEX idx_backports_package_release
                ON backports(package, distro, release);
